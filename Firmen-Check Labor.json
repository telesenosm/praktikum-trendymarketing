    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-haiku-4-5-20251001",
          "mode": "list",
          "cachedResultName": "claude-haiku-4-5-20251001"
        },
        "messages": {
          "values": [
            {
              "content": "=URL: {{ $json.url }}\nTitle ({{ $json.title_laenge }} Zeichen): {{ $json.title }}\nMeta-Description ({{ $json.beschreibung_laenge }} Zeichen): {{ $json.beschreibung }}\nAnzahl H1: {{ $json.h1_anzahl }}\nH1: {{ $json.h1 }}\nH2: {{ $json.h2 }}\nText der Startseite: {{ $json.text }}"
            }
          ]
        },
        "options": {
          "system": "Du bist Analyst bei trendymarketing. Du prüfst die SEO-Grundlagen einer Website nach genau vier Regeln. Regel 1: Title-Länge muss zwischen 30 und 60 Zeichen liegen, sonst minus 0,5 Punkte. Regel 2: Meta-Description-Länge muss zwischen 70 und 160 Zeichen liegen, sonst minus 0,5 Punkte. Regel 3: Es muss genau eine H1 vorhanden sein, sonst minus 0,5 Punkte. Regel 4: Es müssen mindestens zwei H2 vorhanden sein, sonst minus 0,5 Punkte. Ausgangsnote ist 6. Die seo_note ist immer eine ganze Zahl von 1 bis 6. Schreib in seo_schwaechen und ansatzpunkte nur die Fehler, die du wirklich gefunden hast – maximal drei Sätze pro Feld. Erfinde keine anderen Fehler. Antworte immer mit genau diesem JSON-Format mit allen sieben Feldern, keine Backticks, keine Zeilenumbrüche, keine zusätzlichen Zeichen: {\"firma\": \"Beispiel GmbH\", \"branche\": \"Handel\", \"angebot\": \"Online-Shop\", \"seo_note\": 5, \"seo_schwaechen\": \"Title zu kurz\", \"ansatzpunkte\"e auf 40 Zeichen erweitern\", \"fazit\": \"Gute Basis\"}.",
          "maxTokens": 1200,
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        288,
        192
      ],
      "id": "3f1bf604-4fe6-4eaa-9b34-8b06e575136e",
      "name": "Claude analysiert",
      "credentials": {
        "anthropicApi": {
          "id": "fBINadOSI63j4eUx",
          "name": "Praktikum"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Läuft einmal pro Website\nconst roh = $json.content?.find(c => c.type === 'text')?.text ?? '';\nconst sauber = roh.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet analyse = null;\nconst fehler = [];\n\ntry {\n  analyse = JSON.parse(sauber);\n} catch (e) {\n  fehler.push('Kein gültiges JSON: ' + e.message);\n}\n\nif (analyse) {\n  const pflicht = ['firma', 'branche', 'angebot', 'seo_note', 'seo_schwaechen', 'ansatzpunkte', 'fazit'];\n  for (const feld of pflicht) {\n    if (analyse[feld] === undefined || analyse[feld] === '') fehler.push('Feld fehlt: ' + feld);\n  }\n\n  // DEINE AUFGABE: Prüfe hier, ob seo_note eine ganze Zahl von 1 bis 6 ist.\n  if (!Number.isInteger(analyse.seo_note) || analyse.seo_note < 1 || analyse.seo_note > 6) fehler.push('seo_note muss eine ganze Zahl von 1 bis 6 sein');\n  \n  // Wenn nicht, hängst du mit fehler.push(...) einen Fehler an.\n\n}\n\nreturn {\n  json: {\n    url: $('Für Claude vorbereiten').item.json.url,\n    ok: fehler.length === 0,\n    fehler,\n    analyse,\n    roh\n  }\n};"
      },
